# Copia a .env (o exporta las variables) antes de arrancar con: npm start
ANTHROPIC_API_KEY=sk-ant-...          # o configúrala en la pantalla Configuración (se guarda solo en el servidor)
ANTHROPIC_MODEL=claude-opus-5-5       # modelo multimodal (PDF + imágenes); se puede cambiar en Configuración
ANTHROPIC_EFFORT=medium               # low | medium | high | xhigh | max (omitido automáticamente en modelos que no lo admiten)

PORT=3000
HOST=127.0.0.1                        # 0.0.0.0 solo detrás de APP_PASSWORD y HTTPS
# APP_USER=farmacia
# APP_PASSWORD=cambia-esto            # activa autenticación básica
DATA_DIR=./data                       # base de datos SQLite, archivo, secretos
MAX_CONCURRENCY=2                     # facturas procesadas en paralelo
POLL_INTERVAL_SEC=30                  # sondeo de carpeta local y de Drive

# Google Drive (OAuth "Aplicación web"; URI de redirección: http://localhost:3000/api/drive/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
